# Copia este archivo como .env y pega tus claves. Nunca subas .env a ningún repositorio.

# Obligatorias
TYPESAFE_API_KEY=
YOUTUBE_API_KEY=
DEEPSEEK_API_KEY=

# Búsqueda web para LinkedIn, TikTok e Instagram (plan gratuito en https://app.tavily.com)
TAVILY_API_KEY=

# Reddit (opcional): crea una app tipo "script" en https://www.reddit.com/prefs/apps
# Sin estas claves, Reddit usa los feeds RSS públicos (sin métricas).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=radar-30x/0.1 (hackathon JEV)

# Instagram Graph API (opcional): ID de una cuenta profesional + token de acceso de larga duración.
# Sin estas claves, Instagram usa búsqueda web (sin métricas).
IG_USER_ID=
IG_ACCESS_TOKEN=
